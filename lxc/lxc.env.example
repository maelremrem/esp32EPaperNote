# Literal settings for deploy-proxmox.sh --unattended (no shell expansions).
# No-argument deployment is interactive and ignores this file.
VMID=230
HOSTNAME=voice-notes-stt
STORAGE=local-lvm
TEMPLATE_STORAGE=local
BRIDGE=vmbr0
IP_CONFIG=dhcp
# For static networking set IP_CONFIG=192.168.1.50/24 and GATEWAY=192.168.1.1.
GATEWAY=none
# Use a reachable LAN DNS IPv4 if public DNS is blocked; inherit is opt-in.
DNS=1.1.1.1
CORES=4
MEMORY_MB=4096
SWAP_MB=1024
DISK_GB=16
UNPRIVILEGED=1
START_ON_BOOT=1

# Always unprivileged; UNPRIVILEGED=0 is rejected.
# Server settings. Leave API_TOKEN empty to generate inside the CT.
# Optional supplied token: letters/digits/dot/underscore/hyphen only.
API_TOKEN=
WHISTLE_LANGUAGE=fr
