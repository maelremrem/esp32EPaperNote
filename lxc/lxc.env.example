# Proxmox LXC settings
VMID=230
HOSTNAME=voice-notes-stt
STORAGE=local-lvm
TEMPLATE_STORAGE=local
BRIDGE=vmbr0
IP_CONFIG=dhcp
CORES=4
MEMORY_MB=4096
SWAP_MB=1024
DISK_GB=16
UNPRIVILEGED=1
START_ON_BOOT=1

# Server settings. Leave API_TOKEN empty to generate one during install.
API_TOKEN=
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
