[Unit]
Description=ESP32 Voice Notes Whistle API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voicenotes
Group=voicenotes
WorkingDirectory=/opt/voice-notes/server
EnvironmentFile=/etc/voice-notes.env
Environment=HOME=/var/lib/voice-notes
Environment=HF_HOME=/var/lib/voice-notes/.cache/huggingface
Environment=NEEDLE_TELEMETRY=0
Environment=DO_NOT_TRACK=1
ExecStart=/opt/voice-notes/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voice-notes

[Install]
WantedBy=multi-user.target
