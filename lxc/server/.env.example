VOICE_NOTES_API_TOKEN=CHANGE_ME
VOICE_NOTES_DATA_DIR=/var/lib/voice-notes
WHISTLE_LANGUAGE=fr
# Empty language enables detection: en,de,fr,es,it,nl,pl supported.
# Optional local .cact model override; otherwise fetched on first use.
# NEEDLE_WHISTLE_WEIGHTS=/var/lib/voice-notes/models/whistle.cact
HOME=/var/lib/voice-notes
HF_HOME=/var/lib/voice-notes/.cache/huggingface
NEEDLE_TELEMETRY=0
DO_NOT_TRACK=1
MAX_UPLOAD_BYTES=67108864
